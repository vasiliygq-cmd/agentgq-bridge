<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="MailApp">
  <Id>4e16e2b8-47f1-45e8-9334-9277e7346c32</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>AgentGQ</ProviderName>
  <DefaultLocale>ru-RU</DefaultLocale>
  <DisplayName DefaultValue="AgentGQ Bridge Test"/>
  <Description DefaultValue="Client-side diagnostic for reading the currently opened Outlook message."/>
  <IconUrl DefaultValue="__SITE_URL__/icon.png"/>
  <SupportUrl DefaultValue="__SITE_URL__/"/>
  <AppDomains><AppDomain>__SITE_ORIGIN__</AppDomain></AppDomains>
  <Hosts><Host Name="Mailbox"/></Hosts>
  <Requirements><Sets DefaultMinVersion="1.1"><Set Name="Mailbox" MinVersion="1.1"/></Sets></Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings><SourceLocation DefaultValue="__SITE_URL__/taskpane.html"/><RequestedHeight>400</RequestedHeight></DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
</OfficeApp>
